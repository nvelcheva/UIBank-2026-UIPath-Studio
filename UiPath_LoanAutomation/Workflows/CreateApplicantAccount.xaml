<?xml version="1.0" encoding="utf-8"?>
<Activity mc:Ignorable="sap sap2010 sads" x:Class="CreateApplicantAccount"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_LoanData" Type="InArgument(scg:Dictionary(x:String, x:Object))" />
    <x:Property Name="in_LoanID" Type="InArgument(x:String)" />
    <x:Property Name="out_AccountCreated" Type="OutArgument(x:Boolean)" />
  </x:Members>
  <mva:VisualBasic.Settings>
    <x:Null />
  </mva:VisualBasic.Settings>
  
  <Sequence DisplayName="Create Applicant Account (New Application)">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="ApplicantEmail" />
      <Variable x:TypeArguments="x:String" Name="GeneratedPassword" />
      <Variable x:TypeArguments="ui:Browser" Name="Browser" />
    </Sequence.Variables>
    
    <!-- Note: This workflow handles the "New Application" scenario
         where the Loan ID indicates the applicant doesn't have an existing account.
         Per requirements: NO EMAILS should be sent to clients. -->
    
    <Assign DisplayName="Get Email">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[ApplicantEmail]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_LoanData("Email").ToString()]</InArgument>
      </Assign.Value>
    </Assign>
    
    <!-- Generate a secure password for the applicant -->
    <Assign DisplayName="Generate Password">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[GeneratedPassword]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["Loan_" &amp; Guid.NewGuid().ToString().Substring(0,8) &amp; "!Aa1"]</InArgument>
      </Assign.Value>
    </Assign>
    
    <ui:LogMessage DisplayName="Log: Create Applicant Account" Level="Info" Message="[&quot;Creating account for new applicant: &quot; &amp; ApplicantEmail &amp; &quot; (LoanID: &quot; &amp; in_LoanID &amp; &quot;)&quot;]" />
    
    <TryCatch DisplayName="Try Create Account">
      <TryCatch.Try>
        <Sequence DisplayName="Create Account Flow">
          
          <!-- Open UiBank registration page -->
          <ui:OpenBrowser DisplayName="Open Registration" BrowserType="Chrome" Url="https://uibank.uipath.com/register" Browser="[Browser]">
            <ui:OpenBrowser.Body>
              <ActivityAction x:TypeArguments="ui:Browser">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="ui:Browser" Name="browser" />
                </ActivityAction.Argument>
                <Sequence DisplayName="Fill Registration">
                  
                  <ui:BrowserScope Browser="[browser]" DisplayName="Browser Scope">
                    <ui:BrowserScope.Body>
                      <ActivityAction x:TypeArguments="ui:Browser">
                        <ActivityAction.Argument>
                          <DelegateInArgument x:TypeArguments="ui:Browser" Name="b" />
                        </ActivityAction.Argument>
                        <Sequence DisplayName="Registration Form">
                          
                          <Delay DisplayName="Wait Load" Duration="[TimeSpan.FromSeconds(2)]" />
                          
                          <!-- First Name from Email prefix -->
                          <ui:TypeInto DisplayName="Type First Name" DelayBetweenKeys="30">
                            <ui:TypeInto.Target>
                              <ui:Target Selector="&lt;webctrl tag='INPUT' name='firstName' /&gt;" WaitForReady="COMPLETE" />
                            </ui:TypeInto.Target>
                            <ui:TypeInto.Text>
                              <InArgument x:TypeArguments="x:String">[ApplicantEmail.Split("@"c)(0)]</InArgument>
                            </ui:TypeInto.Text>
                          </ui:TypeInto>
                          
                          <!-- Last Name - Use Country -->
                          <ui:TypeInto DisplayName="Type Last Name" DelayBetweenKeys="30">
                            <ui:TypeInto.Target>
                              <ui:Target Selector="&lt;webctrl tag='INPUT' name='lastName' /&gt;" WaitForReady="COMPLETE" />
                            </ui:TypeInto.Target>
                            <ui:TypeInto.Text>
                              <InArgument x:TypeArguments="x:String">[in_LoanData("Country").ToString()]</InArgument>
                            </ui:TypeInto.Text>
                          </ui:TypeInto>
                          
                          <!-- Email -->
                          <ui:TypeInto DisplayName="Type Email" DelayBetweenKeys="30">
                            <ui:TypeInto.Target>
                              <ui:Target Selector="&lt;webctrl tag='INPUT' name='email' type='email' /&gt;" WaitForReady="COMPLETE" />
                            </ui:TypeInto.Target>
                            <ui:TypeInto.Text>
                              <InArgument x:TypeArguments="x:String">[ApplicantEmail]</InArgument>
                            </ui:TypeInto.Text>
                          </ui:TypeInto>
                          
                          <!-- Password -->
                          <ui:TypeInto DisplayName="Type Password" DelayBetweenKeys="30">
                            <ui:TypeInto.Target>
                              <ui:Target Selector="&lt;webctrl tag='INPUT' name='password' type='password' /&gt;" WaitForReady="COMPLETE" />
                            </ui:TypeInto.Target>
                            <ui:TypeInto.Text>
                              <InArgument x:TypeArguments="x:String">[GeneratedPassword]</InArgument>
                            </ui:TypeInto.Text>
                          </ui:TypeInto>
                          
                          <!-- Submit -->
                          <ui:Click DisplayName="Click Register" ClickType="CLICK_SINGLE">
                            <ui:Click.Target>
                              <ui:Target Selector="&lt;webctrl tag='BUTTON' type='submit' /&gt;" WaitForReady="COMPLETE" />
                            </ui:Click.Target>
                          </ui:Click>
                          
                          <Delay DisplayName="Wait Registration" Duration="[TimeSpan.FromSeconds(3)]" />
                          
                        </Sequence>
                      </ActivityAction>
                    </ui:BrowserScope.Body>
                  </ui:BrowserScope>
                  
                </Sequence>
              </ActivityAction>
            </ui:OpenBrowser.Body>
          </ui:OpenBrowser>
          
          <!-- IMPORTANT: No email sent per requirements -->
          <ui:LogMessage DisplayName="Log: Account Created (No Email)" Level="Info" Message="[&quot;Account created for &quot; &amp; ApplicantEmail &amp; &quot; - NO EMAIL SENT per requirements&quot;]" />
          
          <Assign DisplayName="Set Success">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Boolean">[out_AccountCreated]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
            </Assign.Value>
          </Assign>
          
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" xmlns:s="clr-namespace:System;assembly=mscorlib">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="ex" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Handle Error">
              <ui:LogMessage DisplayName="Log Error" Level="Error" Message="[&quot;Failed to create account: &quot; &amp; ex.Message]" />
              <Assign DisplayName="Set Failed">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:Boolean">[out_AccountCreated]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:Boolean">[False]</InArgument>
                </Assign.Value>
              </Assign>
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
    
  </Sequence>
</Activity>