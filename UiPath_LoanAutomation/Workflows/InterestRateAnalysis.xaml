<?xml version="1.0" encoding="utf-8"?>
<Activity mc:Ignorable="sap sap2010 sads" x:Class="InterestRateAnalysis"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data"
 xmlns:ui="http://schemas.uipath.com/workflow/activities"
 xmlns:uexcel="clr-namespace:UiPath.Excel.Activities;assembly=UiPath.Excel.Activities"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_Results" Type="InArgument(scg:List(scg:Dictionary(x:String, x:Object)))" />
    <x:Property Name="in_OutputPath" Type="InArgument(x:String)" />
  </x:Members>
  <mva:VisualBasic.Settings>
    <x:Null />
  </mva:VisualBasic.Settings>
  
  <Sequence DisplayName="Interest Rate Analysis">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="AnalysisDT" />
      <Variable x:TypeArguments="sd:DataRow" Name="NewRow" />
      <Variable x:TypeArguments="x:Int32" Name="TotalApproved" Default="0" />
      <Variable x:TypeArguments="x:Int32" Name="APRBetterCount" Default="0" />
      <Variable x:TypeArguments="x:Int32" Name="PDFBetterCount" Default="0" />
      <Variable x:TypeArguments="x:Int32" Name="EqualCount" Default="0" />
      <Variable x:TypeArguments="x:Double" Name="TotalAPR" Default="0" />
      <Variable x:TypeArguments="x:Double" Name="TotalEstimated" Default="0" />
      <Variable x:TypeArguments="x:Double" Name="AvgAPR" />
      <Variable x:TypeArguments="x:Double" Name="AvgEstimated" />
      <Variable x:TypeArguments="x:String" Name="Recommendation" />
      <Variable x:TypeArguments="x:Double" Name="CurrentAPR" />
      <Variable x:TypeArguments="x:Double" Name="CurrentEst" />
    </Sequence.Variables>
    
    <ui:LogMessage DisplayName="Log: Start Analysis" Level="Info" Message="Performing interest rate analysis..." />
    
    <!-- Analyze each approved result -->
    <ForEach x:TypeArguments="scg:Dictionary(x:String, x:Object)" DisplayName="For Each Result" Values="[in_Results]">
      <ActivityAction x:TypeArguments="scg:Dictionary(x:String, x:Object)">
        <ActivityAction.Argument>
          <DelegateInArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" Name="result" />
        </ActivityAction.Argument>
        <Sequence DisplayName="Analyze Entry">
          
          <If Condition="[result.ContainsKey(&quot;Status&quot;) AndAlso result(&quot;Status&quot;).ToString() = &quot;APPROVED&quot;]" DisplayName="If Approved">
            <If.Then>
              <Sequence DisplayName="Process Approved">
                
                <Assign DisplayName="Increment Total">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Int32">[TotalApproved]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Int32">[TotalApproved + 1]</InArgument>
                  </Assign.Value>
                </Assign>
                
                <TryCatch DisplayName="Try Parse Rates">
                  <TryCatch.Try>
                    <Sequence DisplayName="Parse and Compare">
                      
                      <!-- Parse APR -->
                      <Assign DisplayName="Parse APR">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Double">[CurrentAPR]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Double">[Double.Parse(result("APRRate").ToString().Replace("%", "").Trim())]</InArgument>
                        </Assign.Value>
                      </Assign>
                      
                      <!-- Parse Estimated -->
                      <Assign DisplayName="Parse Estimated">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Double">[CurrentEst]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Double">[Double.Parse(result("EstimatedInterestRate").ToString().Replace("%", "").Trim())]</InArgument>
                        </Assign.Value>
                      </Assign>
                      
                      <!-- Add to totals -->
                      <Assign DisplayName="Add to Total APR">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Double">[TotalAPR]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Double">[TotalAPR + CurrentAPR]</InArgument>
                        </Assign.Value>
                      </Assign>
                      
                      <Assign DisplayName="Add to Total Est">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Double">[TotalEstimated]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Double">[TotalEstimated + CurrentEst]</InArgument>
                        </Assign.Value>
                      </Assign>
                      
                      <!-- Count comparisons -->
                      <If Condition="[CurrentAPR &lt; CurrentEst]" DisplayName="APR Better?">
                        <If.Then>
                          <Assign DisplayName="Inc APR Better">
                            <Assign.To>
                              <OutArgument x:TypeArguments="x:Int32">[APRBetterCount]</OutArgument>
                            </Assign.To>
                            <Assign.Value>
                              <InArgument x:TypeArguments="x:Int32">[APRBetterCount + 1]</InArgument>
                            </Assign.Value>
                          </Assign>
                        </If.Then>
                        <If.Else>
                          <If Condition="[CurrentAPR > CurrentEst]" DisplayName="PDF Better?">
                            <If.Then>
                              <Assign DisplayName="Inc PDF Better">
                                <Assign.To>
                                  <OutArgument x:TypeArguments="x:Int32">[PDFBetterCount]</OutArgument>
                                </Assign.To>
                                <Assign.Value>
                                  <InArgument x:TypeArguments="x:Int32">[PDFBetterCount + 1]</InArgument>
                                </Assign.Value>
                              </Assign>
                            </If.Then>
                            <If.Else>
                              <Assign DisplayName="Inc Equal">
                                <Assign.To>
                                  <OutArgument x:TypeArguments="x:Int32">[EqualCount]</OutArgument>
                                </Assign.To>
                                <Assign.Value>
                                  <InArgument x:TypeArguments="x:Int32">[EqualCount + 1]</InArgument>
                                </Assign.Value>
                              </Assign>
                            </If.Else>
                          </If>
                        </If.Else>
                      </If>
                      
                    </Sequence>
                  </TryCatch.Try>
                  <TryCatch.Catches>
                    <Catch x:TypeArguments="s:Exception" xmlns:s="clr-namespace:System;assembly=mscorlib">
                      <ActivityAction x:TypeArguments="s:Exception">
                        <ActivityAction.Argument>
                          <DelegateInArgument x:TypeArguments="s:Exception" Name="ex" />
                        </ActivityAction.Argument>
                        <ui:LogMessage DisplayName="Log Parse Error" Level="Warn" Message="[&quot;Could not parse rates for entry: &quot; &amp; ex.Message]" />
                      </ActivityAction>
                    </Catch>
                  </TryCatch.Catches>
                </TryCatch>
                
              </Sequence>
            </If.Then>
          </If>
          
        </Sequence>
      </ActivityAction>
    </ForEach>
    
    <!-- Calculate Averages -->
    <If Condition="[TotalApproved > 0]" DisplayName="If Has Data">
      <If.Then>
        <Sequence DisplayName="Calculate Stats">
          
          <Assign DisplayName="Calc Avg APR">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Double">[AvgAPR]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Double">[Math.Round(TotalAPR / TotalApproved, 2)]</InArgument>
            </Assign.Value>
          </Assign>
          
          <Assign DisplayName="Calc Avg Est">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Double">[AvgEstimated]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Double">[Math.Round(TotalEstimated / TotalApproved, 2)]</InArgument>
            </Assign.Value>
          </Assign>
          
          <!-- Generate Recommendation -->
          <If Condition="[AvgAPR &lt; AvgEstimated]" DisplayName="Determine Recommendation">
            <If.Then>
              <Assign DisplayName="Recommend APR">
                <Assign.To>
                  <OutArgument x:TypeArguments="x:String">[Recommendation]</OutArgument>
                </Assign.To>
                <Assign.Value>
                  <InArgument x:TypeArguments="x:String">["RECOMMENDATION: Use UiBank APR rates. They are on average " &amp; Math.Round(AvgEstimated - AvgAPR, 2).ToString() &amp; "% LOWER than PDF estimates, which will attract more customers."]</InArgument>
                </Assign.Value>
              </Assign>
            </If.Then>
            <If.Else>
              <If Condition="[AvgAPR > AvgEstimated]" DisplayName="Est Better?">
                <If.Then>
                  <Assign DisplayName="Recommend PDF">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[Recommendation]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">["RECOMMENDATION: Use PDF Estimated rates. They are on average " &amp; Math.Round(AvgAPR - AvgEstimated, 2).ToString() &amp; "% LOWER than UiBank APR, which will attract more customers."]</InArgument>
                    </Assign.Value>
                  </Assign>
                </If.Then>
                <If.Else>
                  <Assign DisplayName="Equal Rates">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">[Recommendation]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">["RECOMMENDATION: Both methods produce similar rates on average. Choose based on operational efficiency."]</InArgument>
                    </Assign.Value>
                  </Assign>
                </If.Else>
              </If>
            </If.Else>
          </If>
          
        </Sequence>
      </If.Then>
      <If.Else>
        <Assign DisplayName="No Data">
          <Assign.To>
            <OutArgument x:TypeArguments="x:String">[Recommendation]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">["No approved applications to analyze."]</InArgument>
          </Assign.Value>
        </Assign>
      </If.Else>
    </If>
    
    <!-- Create Analysis DataTable -->
    <Assign DisplayName="Create Analysis DT">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataTable">[AnalysisDT]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataTable">[New DataTable("Analysis")]</InArgument>
      </Assign.Value>
    </Assign>
    
    <InvokeMethod DisplayName="Add Col Metric" MethodName="Add" TargetObject="[AnalysisDT.Columns]">
      <InArgument x:TypeArguments="x:String">["Metric"]</InArgument>
    </InvokeMethod>
    <InvokeMethod DisplayName="Add Col Value" MethodName="Add" TargetObject="[AnalysisDT.Columns]">
      <InArgument x:TypeArguments="x:String">["Value"]</InArgument>
    </InvokeMethod>
    
    <!-- Write Analysis to Excel -->
    <uexcel:ExcelApplicationScope DisplayName="Excel Scope Analysis" WorkbookPath="[in_OutputPath]" Visible="False">
      <uexcel:ExcelApplicationScope.Body>
        <ActivityAction x:TypeArguments="uexcel:WorkbookApplication">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="uexcel:WorkbookApplication" Name="ExcelWorkbook" />
          </ActivityAction.Argument>
          <uexcel:WriteRange DisplayName="Write Analysis" DataTable="[AnalysisDT]" SheetName="Interest Rate Analysis" StartingCell="A1" AddHeaders="True" />
        </ActivityAction>
      </uexcel:ExcelApplicationScope.Body>
    </uexcel:ExcelApplicationScope>
    
    <ui:LogMessage DisplayName="Log: Analysis Complete" Level="Info" Message="[&quot;Interest rate analysis complete. &quot; &amp; Recommendation &amp; &quot;&quot;]" />
    
  </Sequence>
</Activity>
